# ============================================================
# 每日优惠情报 · 环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env
#
# 优先级：管理后台保存的值 > 本文件中填写了非空值的变量 > 代码默认值。
# 也就是说，网页上的修改始终优先；本文件用于首次部署或为未在后台修改的项提供默认值。
# 修改本文件后需执行 docker compose up -d 重建容器才会生效；
# 管理后台修改的变量保存后立即生效，无需重启。
# ============================================================

# 【可选】Jina Reader API Key。
# linux.do 默认走第三方 RSS 镜像，无需 Jina；仅当镜像与直连都失败时才用它兜底。
# 申请地址：https://jina.ai/reader
JINA_API_KEY=

# 【可选】linux.do 福利分类 RSS 地址。
# 默认使用 https://linuxdorss.longpink.com/welfare.xml（国内可直连、无需 Jina）。
# 如镜像失效，可改为 https://linux.do/c/welfare/36.rss 或你自建的地址。
LINUXDO_FEED_URL=

# 【可选】其他来源地址覆盖，留空使用默认值。
# 这些变量只影响首次初始化；之后可直接在后台「来源管理」修改地址，以后台为准。
# V2EX 默认：https://www.v2ex.com/feed/promotions.xml
# NodeSeek 默认：https://rss.nodeseek.com/
V2EX_FEED_URL=
NODESEEK_FEED_URL=
APPINN_FEED_URL=
GHXI_FEED_URL=
IPLAYSOFT_FEED_URL=
# LowEndBox 默认：https://lowendbox.com/feed/
LOWENDBOX_FEED_URL=
# 吾爱破解默认：https://www.52pojie.cn/forum.php?mod=rss&fid=16（精品软件区）
POJIE_FEED_URL=
# 线报酷默认：https://new.xianbao.fun/category-weibo/
XIANBAO_FEED_URL=
# 酷安默认：https://new.xianbao.fun/category-kuan/
KUAN_FEED_URL=
EPIC_API_URL=

# 【可选】出站 HTTP/HTTPS 代理，例如 http://127.0.0.1:7890。
# Node 内置 fetch 默认不读取代理环境变量；Docker 中请用此项，本地开发也兼容 HTTPS_PROXY/HTTP_PROXY。
# 配置后所有来源请求都会走该代理；留空则直连。
OUTBOUND_PROXY=

# ------------------------------------------------------------
# AI 改写（可选）：用 OpenAI 兼容接口改写标题并生成摘要
# 只改写已抓到的标题/正文，不新增事实；不配置 API Key 时自动关闭。
# ------------------------------------------------------------
LLM_ENABLED=true
# OpenAI 兼容地址，需包含 /v1；留空则关闭 AI 改写
LLM_BASE_URL=
LLM_API_KEY=
# 例如 Qwen/Qwen2.5-7B-Instruct；留空则关闭 AI 改写
LLM_MODEL=
# 每轮最多处理多少条待生成摘要的条目（控制耗时与成本）
LLM_MAX_ITEMS_PER_RUN=80
# 每批合并多少条一起请求，默认 20，建议 20–30，过大可能输出截断
AI_SUMMARY_BATCH_SIZE=20
# 一批有缺失时，同一轮只再补请求一次，最多补多少条
AI_SUMMARY_RETRY_SIZE=10
# 同一条摘要失败达到该次数后不再重试，保留原标题
AI_SUMMARY_MAX_ATTEMPTS=3
# 是否在生成 AI 摘要时顺带为每条优惠打品类标签（奶茶、咖啡、云服务器等）。
AI_TAGS_ENABLED=true
# 品类标签词表，逗号或换行分隔；留空使用内置词表。
# 新增品类后保存即可，存量数据可在后台「品类标签」区域点「重新打标」按新词表重跑。
AI_TAG_VOCABULARY=
# 是否允许 AI 在词表外提出新品类词；提议词会立即进入索引，但只进入候选池。
AI_TAGS_PROPOSE_ENABLED=true
# 每条优惠最多提出几个新品类词，默认 2，范围 0–3；0 表示不提议。
AI_TAGS_PROPOSE_MAX=2
# 提议标签被多少条优惠使用后可转正，默认 3，范围 2–20。
# 达到阈值的提议标签也会进入零结果标签建议。
AI_TAGS_PROMOTE_THRESHOLD=3
# 待审核候选池上限，默认 500，范围 50–5000；超出后优先淘汰只出现过一次的。
AI_TAGS_CANDIDATE_LIMIT=500
# 是否从标题与描述中抽取品牌、产品实体写入选搜索索引（权重低于标题）。
AI_TAGS_BRAND_EXTRACT_ENABLED=true
# 搜索无结果时最多推荐几个可点击标签，默认 6，范围 0–12；0 表示不推荐。
SEARCH_SUGGEST_TAGS=6
# 召回有候选但 AI 精排全部过滤时，是否再改写一次搜索词重新精排。
SEARCH_REWRITE_ON_EMPTY_RERANK=true
# 是否允许前台使用 AI 搜索；关闭后仅保留普通搜索（标题/摘要关键词匹配）。
AI_SEARCH_ENABLED=true
# AI 搜索范围：active（所有未过期优惠）或 days（按下面的天数）。
AI_SEARCH_SCOPE=active
# AI 搜索按天数模式的时间范围（天），默认 3；不会超过 DATA_RETENTION_DAYS。
AI_SEARCH_DAYS=3
# 普通搜索默认时间范围（天），默认 30；不会超过 DATA_RETENTION_DAYS。
KEYWORD_SEARCH_DAYS=30
# 完整流程：全文索引召回 → 本地新鲜度/来源排序 → AI 精排。
# 全文索引召回候选条数，默认 60；数据量大时可调到 80–100。
AI_SEARCH_RECALL_LIMIT=60
# AI 从候选中最多返回多少条，默认 20。
AI_SEARCH_RERANK_LIMIT=20
# 关闭后不调用 AI 精排，直接返回全文索引排序结果。
AI_SEARCH_RERANK_ENABLED=true
# AI 精排时是否参考摘要（关闭则只发标题，更省 token）。
AI_SEARCH_USE_SUMMARY=true
# 是否启用 SQLite FTS5 全文索引；仅在索引异常时临时关闭，关闭后回退旧粗筛逻辑。
AI_SEARCH_FTS_ENABLED=true
# 是否启用同义词扩展（白嫖→免费、云服务器→VPS 等）。
AI_SEARCH_SYNONYM_ENABLED=true
# 第一次搜索零结果时，让模型把口语改写成品类词再召回一次。
AI_SEARCH_REWRITE_ENABLED=true
# 改写请求超时（毫秒），超时直接返回空结果，避免拖慢搜索。
AI_SEARCH_REWRITE_TIMEOUT_MS=8000
# 全站每分钟最多触发多少次改写，控制额外模型成本。
AI_SEARCH_REWRITE_PER_MINUTE=20
# 每条优惠进入全文索引的最大字符数，默认 400，范围 200–1000；修改后需在后台重建索引。
AI_SEARCH_INDEX_MAX_CHARS=400
# 每个来源最多进入多少条候选，0 表示不限制。
AI_SEARCH_MAX_PER_SOURCE=0
# AI 搜索专用模型；留空则沿用 LLM_MODEL。
AI_SEARCH_MODEL=
# 普通搜索最多返回条数，默认 100，范围 20–500。
KEYWORD_SEARCH_MAX_RESULTS=100
# 以下是旧回退逻辑参数，仅在 AI_SEARCH_FTS_ENABLED=false 时生效。
# 旧版粗筛最多提交多少条标题给模型（默认 500）。
AI_SEARCH_MAX_ITEMS=500
# 旧版粗筛策略：balanced（按来源均衡）或 recent（只取最新）
AI_SEARCH_COARSE_STRATEGY=balanced
# 搜索结果缓存
AI_SEARCH_CACHE_ENABLED=true
AI_SEARCH_CACHE_MINUTES=5
# 并发请求数，建议 2–3，过高可能被限流
LLM_CONCURRENCY=3
# 单次批量请求超时（毫秒），默认 120000
LLM_TIMEOUT_MS=120000

# ------------------------------------------------------------
# 站点显示：首页顶部三处文案
# 也可在管理后台「站点显示」中修改；本文件填了非空值时优先。
# ------------------------------------------------------------
SITE_LABEL=Daily Deals
SITE_TITLE=每日优惠情报
SITE_TAGLINE=AI 精简 · 定时自动聚合 · 只收录真实来源
# 站点公开地址，用于推送里的详情页链接；留空回退原始优惠链接
SITE_URL=

# ------------------------------------------------------------
# 限流：防止搜索与后台登录被刷
# ------------------------------------------------------------
RATE_LIMIT_ENABLED=true
SEARCH_RATE_LIMIT_PER_MINUTE=60
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=5

# ------------------------------------------------------------
# 用户与订阅：登录、注册开关、邀请码与配额
# 也可在管理后台「用户与订阅」分组修改，后台保存的值优先。
# ------------------------------------------------------------
# 是否开放注册；关闭后只能登录已有账号
REGISTRATION_OPEN=true
# 注册是否必须填写邀请码（邀请码在后台「邀请码管理」生成）
REGISTRATION_INVITE_REQUIRED=false
# 旧版固定邀请码，仅用于兼容；留空表示不启用
REGISTRATION_INVITE_CODE=
# 每个登录用户每天的 AI 搜索次数，0 表示不限制
AI_SEARCH_DAILY_LIMIT=50
# 每个用户最多创建多少个关键词订阅
ACCOUNT_MAX_SUBSCRIPTIONS=20
# 每个用户每种推送渠道最多绑定几个机器人
ACCOUNT_MAX_CHANNELS_PER_KIND=2
# 每个用户每天最多收到多少条订阅推送
ACCOUNT_DAILY_PUSH_LIMIT=20
# 超限后不再顺延次日，而是在下面时间合并成一条摘要
DIGEST_OVERFLOW_ENABLED=true
DIGEST_OVERFLOW_TIME=20:30
# 每天向所有订阅用户发送全站优惠汇总，不占个人推送额度
DIGEST_SITE_ENABLED=true
DIGEST_SITE_TIME=21:00
DIGEST_SITE_MAX_ITEMS=8

# ------------------------------------------------------------
# 通知渠道：系统告警使用（来源连续抓取失败等）
# 用户订阅推送由每个用户在 /account 绑定自己的机器人，不读这里的配置。
# ------------------------------------------------------------
# 企业微信群机器人
NOTIFY_WECOM_ENABLED=true
NOTIFY_WECOM_WEBHOOK=
# 飞书群机器人；留空则回退使用下方旧版 FEISHU_WEBHOOK_URL
NOTIFY_FEISHU_ENABLED=true
NOTIFY_FEISHU_WEBHOOK=
NOTIFY_FEISHU_SECRET=
# 钉钉群机器人
NOTIFY_DINGTALK_ENABLED=true
NOTIFY_DINGTALK_WEBHOOK=
NOTIFY_DINGTALK_SECRET=
# Bark iOS 推送
NOTIFY_BARK_ENABLED=true
NOTIFY_BARK_KEY=

# ------------------------------------------------------------
# 告警规则：来源连续抓取失败时推送到上面已启用的通知渠道
# ------------------------------------------------------------
ALERTS_ENABLED=true
ALERT_FAILURE_THRESHOLD=3
ALERT_COOLDOWN_MINUTES=60
# 旧版飞书告警配置，仅用于兼容；建议改用上面的 NOTIFY_FEISHU_*
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=

# ------------------------------------------------------------
# 数据库自动备份（备份文件在 ./data/backups，随数据卷保留）
# ------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7
BACKUP_DIR=./data/backups

# ------------------------------------------------------------
# 接口与容器日志
# ------------------------------------------------------------
# 数据未变化时返回 304，减少轮询流量
API_ETAG_ENABLED=true
# Docker json-file 日志轮转上限
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# ------------------------------------------------------------
# 管理后台（/admin）
# 不配置 ADMIN_PASSWORD 时后台登录不可用。
# ------------------------------------------------------------
ADMIN_PASSWORD=
# 【可选】会话签名密钥；留空则使用 ADMIN_PASSWORD 派生。建议填一段随机字符串。
ADMIN_SESSION_SECRET=

# 【可选】SQLite 数据库文件路径，默认 ./data/app.db。
# Docker 中请保持在 ./data 目录下（容器内为 /app/data），否则重建容器后数据可能丢失。
DATABASE_PATH=./data/app.db

# 【可选】自动抓取间隔（分钟），默认 120（即 2 小时）。允许范围 5–1440。
FETCH_INTERVAL_MINUTES=120

# 【可选】数据保留天数，默认 30。允许范围 1–365；影响首页展示与搜索范围。
DATA_RETENTION_DAYS=30

# 【可选】容器时区，默认 Asia/Shanghai。
TZ=Asia/Shanghai

# ------------------------------------------------------------
# 订阅向量匹配（默认关闭，可在管理后台「订阅向量」分组开启）
# ------------------------------------------------------------
# 【可选】OpenAI 兼容的 embedding 接口 base 地址，例如 https://api.example.com/v1
EMBEDDING_API_URL=
# 【可选】embedding 接口密钥；也可在后台填写，后台值优先。
EMBEDDING_API_KEY=
# 【可选】embedding 模型，默认 Qwen/Qwen3-Embedding-8B。
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# 【可选】宿主机访问端口，默认 3000。容器内部始终监听 3000。
PORT=3000
