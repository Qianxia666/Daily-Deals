# ============================================================
# 每日优惠情报 · 环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env
#
# 优先级：本文件中填写了非空值的变量 > 管理后台保存的值 > 代码默认值。
# 也就是说，所有管理后台的变量都可以在这里配置；留空的项继续沿用后台配置。
# 修改本文件后需执行 docker compose up -d 重建容器才会生效；
# 管理后台修改的变量保存后立即生效，无需重启。
# ============================================================

# 【可选】Jina Reader API Key。
# linux.do 默认走第三方 RSS 镜像，无需 Jina；仅当镜像与直连都失败时才用它兜底。
# 申请地址：https://jina.ai/reader
JINA_API_KEY=

# 【可选】linux.do 福利分类 RSS 地址。
# 默认使用 https://linuxdorss.longpink.com/welfare.xml（国内可直连、无需 Jina）。
# 如镜像失效，可改为 https://linux.do/c/welfare/36.rss 或你自建的地址。
LINUXDO_FEED_URL=

# 【可选】其他来源地址覆盖，留空使用默认值。
# V2EX 默认：https://www.v2ex.com/feed/promotions.xml
# NodeSeek 默认：https://rss.nodeseek.com/
V2EX_FEED_URL=
NODESEEK_FEED_URL=
APPINN_FEED_URL=
GHXI_FEED_URL=
IPLAYSOFT_FEED_URL=
# LowEndBox 默认：https://lowendbox.com/feed/
LOWENDBOX_FEED_URL=
# 吾爱破解默认：https://www.52pojie.cn/forum.php?mod=rss&fid=16（精品软件区）
POJIE_FEED_URL=
# 线报酷默认：https://new.xianbao.fun/category-weibo/
XIANBAO_FEED_URL=
# 酷安默认：https://new.xianbao.fun/category-kuan/
KUAN_FEED_URL=
EPIC_API_URL=

# 【可选】出站 HTTP/HTTPS 代理，例如 http://127.0.0.1:7890。
# Node 内置 fetch 默认不读取代理环境变量；Docker 中请用此项，本地开发也兼容 HTTPS_PROXY/HTTP_PROXY。
# 配置后所有来源请求都会走该代理；留空则直连。
OUTBOUND_PROXY=

# ------------------------------------------------------------
# AI 改写（可选）：用 OpenAI 兼容接口改写标题并生成摘要
# 只改写已抓到的标题/正文，不新增事实；不配置 API Key 时自动关闭。
# ------------------------------------------------------------
LLM_ENABLED=true
# 是否允许前台使用 AI 搜索；关闭后仅保留普通搜索（标题/摘要关键词匹配）。
AI_SEARCH_ENABLED=true
# AI 搜索默认时间范围（天），默认 3；不会超过 DATA_RETENTION_DAYS。
AI_SEARCH_DAYS=3
# 普通搜索默认时间范围（天），默认 30；不会超过 DATA_RETENTION_DAYS。
KEYWORD_SEARCH_DAYS=30
# OpenAI 兼容地址，需包含 /v1；留空则关闭 AI 改写
LLM_BASE_URL=
LLM_API_KEY=
# 例如 Qwen/Qwen3-30B-A3B-Instruct-2507；留空则关闭 AI 改写
LLM_MODEL=
# 每轮最多处理多少条待生成摘要的条目（控制耗时与成本）
LLM_MAX_ITEMS_PER_RUN=80
# 每批合并多少条一起请求，默认 20，建议 20–30，过大可能输出截断
AI_SUMMARY_BATCH_SIZE=20
# 一批有缺失时，同一轮只再补请求一次，最多补多少条
AI_SUMMARY_RETRY_SIZE=10
# 同一条摘要失败达到该次数后不再重试，保留原标题
AI_SUMMARY_MAX_ATTEMPTS=3
# AI 搜索最多把多少条标题交给模型（默认 500；设大即可覆盖全部时间范围）
AI_SEARCH_MAX_ITEMS=500
# 超出上限时的粗筛策略：balanced（按来源均衡）或 recent（只取最新）
AI_SEARCH_COARSE_STRATEGY=balanced
# 搜索结果缓存
AI_SEARCH_CACHE_ENABLED=true
AI_SEARCH_CACHE_MINUTES=5
# 并发请求数，建议 2–3，过高可能被限流
LLM_CONCURRENCY=3
# 单次批量请求超时（毫秒），默认 120000
LLM_TIMEOUT_MS=120000

# ------------------------------------------------------------
# 站点显示：首页顶部三处文案
# 也可在管理后台「站点显示」中修改；本文件填了非空值时优先。
# ------------------------------------------------------------
SITE_LABEL=Daily Deals
SITE_TITLE=每日优惠情报
SITE_TAGLINE=AI 精简 · 定时自动聚合 · 只收录真实来源

# ------------------------------------------------------------
# 限流：防止搜索与后台登录被刷
# ------------------------------------------------------------
RATE_LIMIT_ENABLED=true
SEARCH_RATE_LIMIT_PER_MINUTE=60
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=5

# ------------------------------------------------------------
# 告警：来源连续抓取失败时推送到飞书群
# 飞书群添加「自定义机器人」后复制 Webhook 地址；开启签名校验时再填密钥。
# ------------------------------------------------------------
ALERTS_ENABLED=true
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=
ALERT_FAILURE_THRESHOLD=3
ALERT_COOLDOWN_MINUTES=60

# ------------------------------------------------------------
# 数据库自动备份（备份文件在 ./data/backups，随数据卷保留）
# ------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7
BACKUP_DIR=./data/backups

# ------------------------------------------------------------
# 接口与容器日志
# ------------------------------------------------------------
# 数据未变化时返回 304，减少轮询流量
API_ETAG_ENABLED=true
# Docker json-file 日志轮转上限
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# ------------------------------------------------------------
# 管理后台（/admin）
# 不配置 ADMIN_PASSWORD 时后台登录不可用。
# ------------------------------------------------------------
ADMIN_PASSWORD=
# 【可选】会话签名密钥；留空则使用 ADMIN_PASSWORD 派生。建议填一段随机字符串。
ADMIN_SESSION_SECRET=

# 【可选】SQLite 数据库文件路径，默认 ./data/app.db。
# Docker 中请保持在 ./data 目录下（容器内为 /app/data），否则重建容器后数据可能丢失。
DATABASE_PATH=./data/app.db

# 【可选】自动抓取间隔（分钟），默认 120（即 2 小时）。允许范围 5–1440。
FETCH_INTERVAL_MINUTES=120

# 【可选】数据保留天数，默认 30。允许范围 1–365；影响首页展示与搜索范围。
DATA_RETENTION_DAYS=30

# 【可选】容器时区，默认 Asia/Shanghai。
TZ=Asia/Shanghai

# 【可选】宿主机访问端口，默认 3000。容器内部始终监听 3000。
PORT=3000
